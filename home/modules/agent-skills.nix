{ config, lib, pkgs, ... }:

let
  source = ../../config/agent-skills/typesafe-ai;
  policy = ../../config/agents/nix-source-policy.md;
  context7 = ../../config/claude/rules/context7.md;

  # Claude loads context7.md (claude.nix) and the policy (below) as two rules
  # from ~/.claude/rules/. Codex, OpenCode and Antigravity each read one global
  # instructions file, so they get both in one, built from the same two files
  # at every rebuild: edit those, never the generated copies. All three only
  # read their global file, so a read-only link into /nix/store is safe:
  #   Codex     $CODEX_HOME/AGENTS.md (AGENTS.override.md wins if present);
  #             its Claude import writes AGENTS.md only when it is missing or
  #             empty (codex-rs codex-home/src/instructions, external-agent-
  #             migration/src/service.rs).
  #   OpenCode  ~/.config/opencode/AGENTS.md (opencode.ai/v2/docs/instructions;
  #             v2 reads AGENTS.md only, no CLAUDE.md fallback).
  #   agy       ~/.gemini/config/AGENTS.md: a standalone AGENTS.md or GEMINI.md
  #             in the global customisation root (agy 1.3.0's bundled
  #             agy-customizations skill and changelog). Only one of the two,
  #             so the rules are not loaded twice; the agent asks before
  #             editing files there.
  instructions = ''
    <!-- Generated by home/modules/agent-skills.nix from
         config/claude/rules/context7.md and config/agents/nix-source-policy.md
         (Claude Code reads the same two files from ~/.claude/rules/).
         Edit those and rebuild; changes here are overwritten. -->

    ${lib.removeSuffix "\n" (builtins.readFile context7)}

    ${builtins.readFile policy}'';

  homeDir = config.home.homeDirectory;
  # Codex and OpenCode move their global directory with CODEX_HOME and
  # OPENCODE_CONFIG_DIR, as mcp-sync.py and opencode.nix honour at run time.
  # A declared file can only follow a value declared here as well.
  envDir = name: default:
    let dir = config.home.sessionVariables.${name} or default; in
    assert lib.assertMsg (lib.hasPrefix "${homeDir}/" dir)
      "agent-skills.nix: ${name} (${dir}) must be under ${homeDir} to link AGENTS.md into it";
    lib.removePrefix "${homeDir}/" dir;
  codexDir = envDir "CODEX_HOME" "${homeDir}/.codex";
  opencodeDir = envDir "OPENCODE_CONFIG_DIR" "${config.xdg.configHome}/opencode";
in
{
  # One vendored skill, available offline on activation. Model providers
  # (cloud APIs or local llama.cpp) use the same client skill directories.
  home.file = {
    ".agents/skills/typesafe-ai".source = source;
    ".claude/skills/typesafe-ai".source = source;
    ".config/opencode/skills/typesafe-ai".source = source;
    # Antigravity CLI (agy): global skills live in ~/.gemini/config/skills/
    # (the root of its machine-wide customisations, per agy 1.3.0's bundled
    # agy-customizations and migrate-workflows skills). ~/.gemini/skills/ was
    # Gemini CLI's, which was removed (modules/software/development.nix).
    ".gemini/config/skills/typesafe-ai".source = source;
    ".claude/rules/nix-source.md".source = policy;
    "${codexDir}/AGENTS.md".text = instructions;
    "${opencodeDir}/AGENTS.md".text = instructions;
    ".gemini/config/AGENTS.md".text = instructions;
    ".agents/skills/nix-source/SKILL.md".text = ''
      ---
      name: nix-source
      description: Safe source handling when evaluating or building Nix flakes in repositories.
      ---
      ${builtins.readFile policy}
    '';
  };

  # Also support additional clients and hosted development environments.
  home.packages = [ (pkgs.writeShellApplication {
    name = "install-agent-skills";
    runtimeInputs = [ pkgs.nodejs pkgs.git ];
    text = builtins.readFile ../../scripts/install-agent-skills.sh;
  }) (pkgs.writeShellScriptBin "with-typesafe" ''
    exec ${pkgs.python3}/bin/python3 ${../../scripts/with-typesafe-env.py} "$@"
  '') ];
}
