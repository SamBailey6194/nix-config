From: Claude Security Review <security@anthropic.com>
Date: Sat, 25 Jan 2026 00:00:00 +0000
Subject: [PATCH 1/11] security: Fix decompression bomb vulnerability (HIGH)

Add 100MB limit to decompress() function to prevent OOM attacks from
malicious compressed files that could expand to gigabytes.

Severity: HIGH
Impact: Prevents denial-of-service via decompression bombs
---
 rust/malware-scanner/src/quarantine/storage.rs | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/rust/malware-scanner/src/quarantine/storage.rs b/rust/malware-scanner/src/quarantine/storage.rs
index 1234567..abcdefg 100644
--- a/rust/malware-scanner/src/quarantine/storage.rs
+++ b/rust/malware-scanner/src/quarantine/storage.rs
@@ -302,10 +302,22 @@ impl QuarantineStorage {
     fn decompress(&self, data: &[u8]) -> Result<Vec<u8>> {
         use flate2::read::GzDecoder;
         use std::io::Read;

+        // SECURITY: Limit decompressed size to prevent decompression bomb attacks
+        const MAX_DECOMPRESSED_SIZE: u64 = 100 * 1024 * 1024; // 100MB
+
         let mut decoder = GzDecoder::new(data);
         let mut decompressed = Vec::new();
-        decoder.read_to_end(&mut decompressed)?;
+
+        // Use take() to limit how much we read
+        let mut limited_decoder = decoder.take(MAX_DECOMPRESSED_SIZE);
+        limited_decoder.read_to_end(&mut decompressed)?;
+
+        // Check if we hit the limit
+        if decompressed.len() >= MAX_DECOMPRESSED_SIZE as usize {
+            anyhow::bail!(
+                "Decompressed file exceeds safety limit (100MB) - possible decompression bomb"
+            );
+        }
+
         Ok(decompressed)
     }
 }
