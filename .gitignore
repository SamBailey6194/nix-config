# Editor temp files
*.swp
*.swo
*~
.DS_Store

# Backup files from install.sh
*.bak

# Nix build results
result
result-*

# Secrets - .age files ARE safe to commit (they're encrypted)
# Never commit unencrypted private keys
id_ed25519*
!*.pub

# Plaintext credentials and agent configs that hold keys: encrypt with agenix
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
auth.json
.claude.json
mcp_config.json

# Only encrypted files and their definitions belong in secrets/
secrets/*
!secrets/*.age
!secrets/secrets.nix
!secrets/README.md
!secrets/.gitkeep

# Rust build artifacts
rust/target/
target/

# Fuzzing artifacts
rust/fuzz/target/
rust/fuzz/artifacts/

# .direnv auto generated folder from .envrc
.direnv/

# Code review graph
.code-review-graph/

# Python bytecode from configuration tests/helpers
__pycache__/
*.pyc
