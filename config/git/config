[user]
    name = Sam Bailey

[core]
    editor = zed --wait
    autocrlf = input
    hooksPath = ~/.config/git/hooks

[init]
    defaultBranch = main

[commit]
    template = ~/.gitmessage

[push]
    autoSetupRemote = true
    default = current

[pull]
    rebase = true

[fetch]
    prune = true

[diff]
    colorMoved = default

[merge]
    conflictstyle = diff3

[alias]
    st = status
    co = checkout
    br = branch
    ci = commit
    lg = log --oneline --graph --decorate -20
    last = log -1 HEAD
    unstage = reset HEAD --
    amend = commit --amend --no-edit
    undo = reset --soft HEAD~1

# Personal repos
[includeIf "gitdir:~/Repos/personal/"]
    path = ~/.gitconfig-personal
[includeIf "gitdir:/mnt/archive/OldRepos/personal/"]
    path = ~/.gitconfig-personal

# Syntek repos
[includeIf "gitdir:~/Repos/syntek/"]
    path = ~/.gitconfig-syntek
[includeIf "gitdir:/mnt/archive/OldRepos/syntek/"]
    path = ~/.gitconfig-syntek

# Missional Gen repos
[includeIf "gitdir:~/Repos/missional-gen/"]
    path = ~/.gitconfig-missional-gen
[includeIf "gitdir:/mnt/archive/OldRepos/missional-gen/"]
    path = ~/.gitconfig-missional-gen
