{
  "feedbackDrafts": "off",
  "model": "opus",
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "MCP_TIMEOUT": "120000"
  },
  "effortLevel": "medium",
  "ultracode": true,
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "editorMode": "normal",
  "verbose": false,
  "switchModelsOnFlag": false,
  "skipAutoPermissionPrompt": true,
  "enableWorkflows": true,
  "disableBundledSkills": true,
  "disableArtifact": true,
  "disableClaudeAiConnectors": true,
  "disableRemoteControl": true,
  "autoCompactEnabled": false,
  "permissions": {
    "allow": [
      "mcp__brave-devtools__*",
      "mcp__firefox-developer__*",
      "mcp__code-review-graph__*",
      "mcp__graphify__*",
      "mcp__elevenlabs__*",
      "Bash(git add *)",
      "Bash(git switch *)",
      "Bash(git commit *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git commit *--no-verify*)",
      "Bash(git push *--no-verify*)",
      "Bash(git commit -n*)",
      "mcp__claude-in-chrome__*",
      "mcp__davinci-resolve__run_script_unsafe",
      "mcp__davinci-resolve__launch_resolve"
    ],
    "ask": [
      "mcp__elevenlabs__make_outbound_call",
      "mcp__davinci-resolve__run_script",
      "mcp__davinci-resolve__update_dctl",
      "mcp__davinci-resolve__generate_lut",
      "mcp__davinci-resolve__delete_dctl",
      "mcp__davinci-resolve__delete_lut",
      "mcp__code-review-graph__apply_refactor_tool",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)"
    ]
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "lua-lsp@claude-plugins-official": true,
    "php-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  }
}
