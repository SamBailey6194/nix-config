{
  "feedbackDrafts": "off",
  "model": "opus",
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "MCP_TIMEOUT": "120000"
  },
  "effortLevel": "xhigh",
  "ultracode": true,
  "promptSuggestionEnabled": false,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipWorkflowUsageWarning": true,
  "editorMode": "normal",
  "verbose": false,
  "switchModelsOnFlag": false,
  "skipAutoPermissionPrompt": true,
  "enableWorkflows": true,
  "disableBundledSkills": true,
  "disableArtifact": true,
  "disableClaudeAiConnectors": true,
  "disableRemoteControl": true,
  "autoCompactEnabled": false,
  "permissions": {
    "allow": [
      "mcp__brave-devtools__*",
      "mcp__firefox-developer__*",
      "mcp__code-review-graph__*",
      "mcp__graphify__*"
    ],
    "deny": [
      "mcp__claude-in-chrome__*",
      "mcp__davinci-resolve__run_script_unsafe",
      "mcp__davinci-resolve__launch_resolve"
    ],
    "ask": [
      "mcp__elevenlabs__text_to_speech",
      "mcp__elevenlabs__speech_to_text",
      "mcp__elevenlabs__compose_music",
      "mcp__elevenlabs__text_to_sound_effects",
      "mcp__elevenlabs__speech_to_speech",
      "mcp__elevenlabs__voice_clone",
      "mcp__elevenlabs__isolate_audio",
      "mcp__elevenlabs__text_to_voice",
      "mcp__elevenlabs__create_voice_from_preview",
      "mcp__davinci-resolve__run_script",
      "mcp__davinci-resolve__update_dctl",
      "mcp__davinci-resolve__generate_lut",
      "mcp__davinci-resolve__delete_dctl",
      "mcp__davinci-resolve__delete_lut",
      "mcp__code-review-graph__apply_refactor_tool"
    ]
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "lua-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  }
}
