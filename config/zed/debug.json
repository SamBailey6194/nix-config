[
  // ============================================
  // PYTHON / DJANGO
  // ============================================
  {
    "label": "Python: Active File",
    "adapter": "Debugpy",
    "request": "launch",
    "program": "$ZED_FILE",
    "cwd": "$ZED_WORKTREE_ROOT",
    "console": "integratedTerminal"
  },
  {
    "label": "Python: Module",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "$ZED_STEM",
    "cwd": "$ZED_WORKTREE_ROOT",
    "console": "integratedTerminal"
  },
  {
    "label": "Django: Runserver",
    "adapter": "Debugpy",
    "request": "launch",
    "program": "${ZED_WORKTREE_ROOT}/manage.py",
    "args": ["runserver", "0.0.0.0:8000", "--noreload"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "console": "integratedTerminal",
    "django": true,
    "justMyCode": false
  },
  {
    "label": "Django: Shell Plus",
    "adapter": "Debugpy",
    "request": "launch",
    "program": "${ZED_WORKTREE_ROOT}/manage.py",
    "args": ["shell_plus"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "console": "integratedTerminal",
    "django": true
  },
  {
    "label": "Django: Custom Command",
    "adapter": "Debugpy",
    "request": "launch",
    "program": "${ZED_WORKTREE_ROOT}/manage.py",
    "args": ["${ZED_SELECTED_TEXT:your_command}"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "console": "integratedTerminal",
    "django": true
  },
  {
    "label": "Pytest: All",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "pytest",
    "args": ["-v", "-s"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "console": "integratedTerminal",
    "justMyCode": false
  },
  {
    "label": "Pytest: Current File",
    "adapter": "Debugpy",
    "request": "launch",
    "module": "pytest",
    "args": ["-v", "-s", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "console": "integratedTerminal",
    "justMyCode": false
  },

  // ============================================
  // JAVASCRIPT / TYPESCRIPT / NODE
  // ============================================
  {
    "label": "Node: Active File",
    "adapter": "JavaScript",
    "request": "launch",
    "program": "$ZED_FILE",
    "cwd": "$ZED_WORKTREE_ROOT",
    "console": "integratedTerminal"
  },
  {
    "label": "Node: Run Script (dev)",
    "adapter": "JavaScript",
    "request": "launch",
    "runtimeExecutable": "npm",
    "runtimeArgs": ["run", "dev"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "console": "integratedTerminal"
  },
  {
    "label": "Node: Run Script (start)",
    "adapter": "JavaScript",
    "request": "launch",
    "runtimeExecutable": "npm",
    "runtimeArgs": ["run", "start"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "console": "integratedTerminal"
  },
  {
    "label": "Next.js: Dev Server",
    "adapter": "JavaScript",
    "request": "launch",
    "runtimeExecutable": "npm",
    "runtimeArgs": ["run", "dev"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "console": "integratedTerminal",
    "serverReadyAction": {
      "pattern": "started server on .+, url: (https?://.+)",
      "uriFormat": "%s",
      "action": "debugWithChrome"
    }
  },
  {
    "label": "Vite: Dev Server",
    "adapter": "JavaScript",
    "request": "launch",
    "runtimeExecutable": "npm",
    "runtimeArgs": ["run", "dev"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "console": "integratedTerminal"
  },
  {
    "label": "Jest: All Tests",
    "adapter": "JavaScript",
    "request": "launch",
    "runtimeExecutable": "npm",
    "runtimeArgs": ["test", "--", "--runInBand"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "console": "integratedTerminal"
  },
  {
    "label": "Jest: Current File",
    "adapter": "JavaScript",
    "request": "launch",
    "runtimeExecutable": "npm",
    "runtimeArgs": ["test", "--", "--runInBand", "$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "console": "integratedTerminal"
  },
  {
    "label": "Node: Attach to Process",
    "adapter": "JavaScript",
    "request": "attach",
    "port": 9229,
    "restart": true,
    "localRoot": "$ZED_WORKTREE_ROOT",
    "remoteRoot": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "Chrome: Attach",
    "adapter": "JavaScript",
    "request": "attach",
    "port": 9222,
    "webRoot": "$ZED_WORKTREE_ROOT"
  },

  // ============================================
  // RUST
  // ============================================
  {
    "label": "Rust: Debug Binary",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "${ZED_WORKTREE_ROOT}/target/debug/${ZED_STEM}",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": [],
    "build": {
      "command": "cargo",
      "args": ["build"]
    }
  },
  {
    "label": "Rust: Debug Release",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "${ZED_WORKTREE_ROOT}/target/release/${ZED_STEM}",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": [],
    "build": {
      "command": "cargo",
      "args": ["build", "--release"]
    }
  },
  {
    "label": "Rust: Debug Tests",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "${ZED_WORKTREE_ROOT}/target/debug/deps/${ZED_STEM}",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": [],
    "build": {
      "command": "cargo",
      "args": ["test", "--no-run"]
    }
  },
  {
    "label": "Rust: Debug Current Test",
    "adapter": "CodeLLDB",
    "request": "launch",
    "program": "${ZED_WORKTREE_ROOT}/target/debug/deps/${ZED_STEM}",
    "cwd": "$ZED_WORKTREE_ROOT",
    "args": ["$ZED_SYMBOL"],
    "build": {
      "command": "cargo",
      "args": ["test", "--no-run"]
    }
  },

  // ============================================
  // PHP
  // ============================================
  {
    "label": "PHP: Active File",
    "adapter": "PHP",
    "request": "launch",
    "program": "$ZED_FILE",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "PHP: Listen for Xdebug",
    "adapter": "PHP",
    "request": "attach",
    "port": 9003,
    "pathMappings": {
      "/var/www/html": "$ZED_WORKTREE_ROOT"
    }
  },
  {
    "label": "PHP: Artisan Serve (Laravel)",
    "adapter": "PHP",
    "request": "launch",
    "program": "${ZED_WORKTREE_ROOT}/artisan",
    "args": ["serve"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "PHP: Artisan Command",
    "adapter": "PHP",
    "request": "launch",
    "program": "${ZED_WORKTREE_ROOT}/artisan",
    "args": ["${ZED_SELECTED_TEXT:migrate}"],
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "PHPUnit: All Tests",
    "adapter": "PHP",
    "request": "launch",
    "program": "${ZED_WORKTREE_ROOT}/vendor/bin/phpunit",
    "cwd": "$ZED_WORKTREE_ROOT"
  },
  {
    "label": "PHPUnit: Current File",
    "adapter": "PHP",
    "request": "launch",
    "program": "${ZED_WORKTREE_ROOT}/vendor/bin/phpunit",
    "args": ["$ZED_FILE"],
    "cwd": "$ZED_WORKTREE_ROOT"
  }
]
