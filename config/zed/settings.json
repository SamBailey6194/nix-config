{
  "theme": "One Dark",
  "ui_font_size": 16,
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 14,
  "format_on_save": "on",
  "tab_size": 2,
  "show_whitespaces": "selection",
  "autosave": "on_focus_change",
  "vim_mode": false,

  "terminal": {
    "shell": { "program": "/usr/bin/zsh" },
    "max_scroll_history_lines": 100000,
    "font_size": 13,
    "font_family": "JetBrains Mono"
  },

  "file_scan_exclusions": [
    "**/.git",
    "**/node_modules",
    "**/__pycache__",
    "**/target",
    "**/.venv",
    "**/dist",
    "**/build"
  ],

  "project_panel": {
    "button": true,
    "dock": "left",
    "default_width": 280,
    "auto_reveal_entries": true,
    "auto_fold_dirs": false,
    "git_status": true
  },

  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true
    }
  },

  "git_panel": {
    "button": true,
    "dock": "left"
  },

  "outline_panel": {
    "button": true,
    "dock": "left"
  },

  "collaboration_panel": {
    "button": false
  },

  "notification_panel": {
    "button": false
  },

  "chat_panel": {
    "button": false
  },

  "assistant": {
    "button": true,
    "dock": "right",
    "default_width": 480
  },

  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": true
  },

  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": true
  },

  "languages": {
    "Python": {
      "tab_size": 4,
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "ruff",
          "arguments": ["format", "-"]
        }
      },
      "language_servers": ["pyright", "ruff"],
      "code_actions_on_format": {
        "source.fixAll": true,
        "source.organizeImports.ruff": true
      }
    },
    "TypeScript": {
      "format_on_save": "on",
      "formatter": "prettier",
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
        "source.organizeImports": true
      }
    },
    "TSX": {
      "format_on_save": "on",
      "formatter": "prettier",
      "code_actions_on_format": {
        "source.fixAll.eslint": true,
        "source.organizeImports": true
      }
    },
    "JavaScript": {
      "format_on_save": "on",
      "formatter": "prettier",
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
    "JSX": {
      "format_on_save": "on",
      "formatter": "prettier",
      "code_actions_on_format": {
        "source.fixAll.eslint": true
      }
    },
    "Markdown": {
      "format_on_save": "on",
      "formatter": "prettier"
    },
    "JSON": {
      "format_on_save": "on",
      "formatter": "prettier"
    },
    "JSONC": {
      "format_on_save": "on",
      "formatter": "prettier"
    },
    "HTML": {
      "format_on_save": "on",
      "formatter": "prettier"
    },
    "CSS": {
      "format_on_save": "on",
      "formatter": "prettier"
    },
    "SCSS": {
      "format_on_save": "on",
      "formatter": "prettier"
    },
    "YAML": {
      "format_on_save": "on",
      "formatter": "prettier"
    },
    "TOML": {
      "format_on_save": "on"
    },
    "Rust": {
      "tab_size": 4,
      "format_on_save": "on"
    },
    "PHP": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "php-cs-fixer",
          "arguments": ["fix", "--using-cache=no", "-"]
        }
      },
      "language_servers": ["intelephense"]
    },
    "Blade": {
      "format_on_save": "on",
      "formatter": "prettier"
    },
    "GraphQL": {
      "format_on_save": "on",
      "formatter": "prettier"
    },
    "SQL": {
      "format_on_save": "on"
    },
    "Dockerfile": {
      "format_on_save": "on"
    }
  },

  "lsp": {
    "pyright": {
      "settings": {
        "python.analysis": {
          "typeCheckingMode": "basic",
          "diagnosticMode": "workspace",
          "autoSearchPaths": true
        }
      }
    },
    "ruff": {
      "initialization_options": {
        "settings": {
          "lint": { "enable": true },
          "format": { "enable": true }
        }
      }
    },
    "rust-analyzer": {
      "initialization_options": {
        "checkOnSave": {
          "command": "clippy"
        },
        "diagnostics": {
          "enable": true
        },
        "cargo": {
          "allFeatures": true
        }
      }
    },
    "tailwindcss-language-server": {
      "initialization_options": {
        "userLanguages": {
          "typescriptreact": "javascript",
          "javascriptreact": "javascript",
          "html": "html",
          "php": "html"
        }
      }
    },
    "typescript-language-server": {
      "initialization_options": {
        "preferences": {
          "includeCompletionsForModuleExports": true,
          "includeCompletionsWithInsertText": true,
          "importModuleSpecifierPreference": "relative"
        }
      }
    },
    "eslint": {
      "settings": {
        "codeActionOnSave": {
          "enable": true,
          "mode": "all"
        }
      }
    }
  },

  "file_types": {
    "Blade": ["*.blade.php"]
  }
}
